# --- LLM (any OpenAI-compatible Chat Completions API) ---
# DeepSeek by default. LLM_API_KEY may be omitted if DEEPSEEK_API_KEY is set in the environment.
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Provider-specific request fields as JSON. For DeepSeek this turns reasoning off (faster, cheaper).
# For OpenAI set LLM_EXTRA_BODY={}
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
LLM_TEMPERATURE=0.2

# --- Service ---
TIMEZONE=Europe/Kyiv
CURRENCY=UAH
DATA_DIR=data

# --- Demo cost guards ---
MAX_MESSAGES_PER_SESSION=40
DAILY_REQUEST_LIMIT=2000

# Host port for docker compose (bound to 127.0.0.1 only)
HOST_PORT=8000
